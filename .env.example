# =============================================================================
# DATABASE
# =============================================================================
# Runtime connection used for USER requests. RLS is only evaluated when this
# connects as a NON-OWNER role (e.g. `nextspark_app`, created by migration 022).
# Until you do the RLS cutover you can keep this as the owner/admin connection
# and everything behaves as before.
DATABASE_URL=postgresql://user:password@localhost:5432/nextspark

# SERVICE connection used for SYSTEM operations that must BYPASS RLS: Better Auth
# login/verification, the scheduler/processor, payment webhooks, the superadmin
# bypass check, and the privileged team/subscription bootstrap. On Supabase use
# the `service_role` connection string (BYPASSRLS); on self-hosted Postgres a
# dedicated owner/bypass role. Optional — falls back to DATABASE_URL when unset
# (pre-cutover). Typically a DIRECT (non-pooler) connection.
# DATABASE_SERVICE_URL=postgresql://service_role:password@localhost:5432/nextspark

# Connection used to RUN MIGRATIONS and seeds (must be the table OWNER). After
# the cutover, DATABASE_URL is the non-owner `nextspark_app`, so migrations need
# the owner credential here. Optional — falls back to DATABASE_URL when unset.
# MIGRATE_DATABASE_URL=postgresql://owner:password@localhost:5432/nextspark

# =============================================================================
# AUTHENTICATION (Better Auth)
# =============================================================================
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
# BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# APP URL
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# APP INFO
# =============================================================================
NEXT_PUBLIC_APP_NAME="NextSpark App"

# =============================================================================
# LOGIN METHODS - Passwordless preset (DEFAULT)
# =============================================================================
# By default the login offers a one-time code by email + Google OAuth and NO
# password field (`auth.methods: ['email-otp', 'google']`). That preset needs:
#   - RESEND_API_KEY + EMAIL_FROM  -> carrier for the 6-digit sign-in code
#   - GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET -> "Continue with Google"
# Without an email provider the code cannot be delivered; without Google
# credentials set `auth.providers.google.enabled: false` (or drop 'google' from
# `auth.methods`) in config/app.config.ts.
# Classic email + password instead: `auth.methods: ['email-password', 'google']`.
# Docs: packages/core/docs/06-authentication/12-passwordless-preset.md

# =============================================================================
# EMAIL (Resend) - Required for the passwordless preset (sign-in codes),
# email verification and password reset
# =============================================================================
RESEND_API_KEY=
# The sender of every email provider (Resend, SMTP). RESEND_FROM_EMAIL /
# RESEND_FROM_NAME, the older names, are still read when these are unset.
EMAIL_FROM_NAME=
EMAIL_FROM=

# SMTP instead of Resend (SendGrid, Mailgun, SES, Postmark, your own server).
# Needs `pnpm add nodemailer`. Uncomment, and set the sender above.
# Docs: packages/core/docs/06-authentication/13-email-providers.md
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# =============================================================================
# FILE STORAGE (media uploads) - Required in production to upload files
# Without a driver, development stores uploads in public/uploads/temp and
# production answers 503 STORAGE_NOT_CONFIGURED.
# Docs: packages/core/docs/21-media-library/05-configuration.md
# =============================================================================
# Vercel Blob (also chosen when STORAGE_DRIVER is unset and this is set):
# STORAGE_DRIVER=vercel-blob
# BLOB_READ_WRITE_TOKEN=
#
# Any S3-compatible service (AWS S3, R2, MinIO, B2, Spaces). Needs `pnpm add aws4fetch`.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false
#
# A directory on this server's disk (single instance; mount it as a volume):
# STORAGE_DRIVER=local
# UPLOADS_DIR=

# =============================================================================
# GOOGLE OAUTH - Required for "Continue with Google" (part of the default preset)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required if using OAuth providers - encrypts OAuth tokens in database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OAUTH_ENCRYPTION_KEY=

# =============================================================================
# OTHER SOCIAL PROVIDERS - Optional (add 'github' / 'microsoft' / 'apple' to auth.methods)
# Setup: packages/core/docs/06-authentication/03-oauth-providers.md
# =============================================================================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_APP_BUNDLE_IDENTIFIER=
# Any other Better Auth provider listed in auth.providers: <ID>_CLIENT_ID / <ID>_CLIENT_SECRET

# =============================================================================
# STRIPE - Optional
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# LEMON SQUEEZY - Optional (billing.config.ts provider: 'lemonsqueezy')
# =============================================================================
# All three are required when the provider is lemonsqueezy. A test-mode API key works on the store's test data.
# Webhook URL: https://<your-app>/api/v1/billing/webhooks/lemonsqueezy
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=       # numeric store id (Settings -> Stores)
# LEMONSQUEEZY_WEBHOOK_SECRET= # the signing secret you set on the webhook (16+ random characters)
# LEMONSQUEEZY_TEAM_TOKEN_SECRET= # optional: key of the checkout team token; defaults to the webhook secret
# LEMONSQUEEZY_ACCEPT_TEST_MODE=true # optional, staging/previews only: a production build applies test-mode events

# =============================================================================
# PADDLE - Optional (billing.config.ts provider: 'paddle')
# =============================================================================
# All three are required when the provider is paddle. Sandbox and live are separate Paddle accounts: use each one's
# own key and webhook secret, never the sandbox ones in production.
# Webhook URL: https://<your-app>/api/v1/billing/webhooks/paddle
# PADDLE_API_KEY=                # Developer tools -> Authentication (pdl_sdbx_... or pdl_live_...)
# PADDLE_WEBHOOK_SECRET=         # the secret key of the notification destination
# PADDLE_ENVIRONMENT=sandbox     # sandbox or production
# PADDLE_TEAM_TOKEN_SECRET=      # optional: key of the checkout team token; defaults to the webhook secret
# PADDLE_WEBHOOK_TOLERANCE_SECONDS=5 # optional: how far a signature's timestamp may be from now, 5 to 300 seconds

# =============================================================================
# UPSTASH REDIS - Optional (for distributed rate limiting)
# =============================================================================
# Get credentials from https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# RATE LIMITING - Optional (development/testing only)
# =============================================================================
# Set to 'true' to disable rate limiting (WARNING: Never use in production!)
# Turns off the per-address limits and Better Auth's limiter (sign-in, sign-up,
# OTP). The per-API-key limit stays on. Only for QA/preview deploys and tests.
# DISABLE_RATE_LIMITING=true

# =============================================================================
# ACT AS USER - Optional (development/testing only)
# =============================================================================
# Set to 'true' to allow the `x-act-as-user` request override (dual-auth): a
# developer can resolve session-scoped endpoints (e.g. /me/*) as another user
# from the API Explorer, without switching sessions. Requires the `developer`
# role and is hard-blocked on production runtimes (VERCEL_ENV / NODE_ENV).
# Off by default. (WARNING: Never enable in production!)
# ALLOW_ACT_AS_USER=true

# =============================================================================
# CORS CONFIGURATION (Optional)
# =============================================================================
# Additional origins for CORS (comma-separated)
# Use for runtime additions without code changes
# Merged with core + theme origins at runtime
# CORS_ADDITIONAL_ORIGINS=http://localhost:8081,https://mobile.myapp.com

# Enable CORS debug logging (shows origin resolution in console)
# NEXTSPARK_DEBUG_CORS=true

# =============================================================================
# CROSS-SUBDOMAIN SESSIONS (Optional, multi-tenant)
# =============================================================================
# Share the auth session cookie across sibling subdomains. Needed when the app
# serves tenants on subdomains (e.g. `<tenant>.myapp.com`) but runs OAuth on the
# apex: OAuth providers don't allow wildcard redirect URIs, so the session is
# established on the apex and must be readable back on the tenant subdomain.
# Set to the shared base domain WITH a leading dot. Leave unset to keep cookies
# host-scoped (the default). Also add the subdomain wildcard to
# CORS_ADDITIONAL_ORIGINS (e.g. https://*.myapp.com) so callbackURL passes.
# COOKIE_BASE_DOMAIN=.myapp.com

# =============================================================================
# CYPRESS TEST CREDENTIALS
# =============================================================================
# Used by Cypress tests for authentication.
# The CYPRESS_ prefix makes them available as Cypress.env('VARIABLE_NAME')
#
# Core system users (pre-installed from core migrations)
CYPRESS_DEVELOPER_EMAIL=developer@nextspark.dev
CYPRESS_DEVELOPER_PASSWORD=Pandora1234
CYPRESS_SUPERADMIN_EMAIL=superadmin@nextspark.dev
CYPRESS_SUPERADMIN_PASSWORD=Pandora1234

# Demo theme users - Uncomment and customize when you create your own test users
# CYPRESS_TEST_PASSWORD=Test1234
# CYPRESS_OWNER_EMAIL=owner@example.com
# CYPRESS_ADMIN_EMAIL=admin@example.com
# CYPRESS_MEMBER_EMAIL=member@example.com
# CYPRESS_EDITOR_EMAIL=editor@example.com
# CYPRESS_VIEWER_EMAIL=viewer@example.com

# =============================================================================
# =============================================================================
# APP CONFIGURATION
# =============================================================================
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# VERCEL (Optional - for Vercel deployments)
# =============================================================================
VERCEL_TEAM=
VERCEL_PROJECT=

# =============================================================================
# SUPERADMIN
# =============================================================================
# API key for superadmin bypass access
# Generate with: node -e "console.log('sk_' + require('crypto').randomBytes(32).toString('hex'))"
SUPERADMIN_API_KEY=

# =============================================================================
# DEBUG SETTINGS
# =============================================================================
NEXT_PUBLIC_RQ_DEVTOOLS=false
NEXT_DISPLAY_DEBUGGER=false

# =============================================================================
# PWA
# =============================================================================
NEXT_PUBLIC_PWA_ENABLED=true

# =============================================================================
# SCHEDULED ACTIONS
# =============================================================================
# Secret for authenticating cron webhook requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# =============================================================================
# =============================================================================
# CLAUDE CODE WORKSPACE (Optional - for Claude Code users)
# =============================================================================
# =============================================================================
# These variables are used by Claude Code MCP servers and integrations.
# Configure based on your preferences.

# =============================================================================
# GITHUB
# =============================================================================
GITHUB_TOKEN=

# =============================================================================
# TASK MANAGER (choose one: ClickUp, Jira, or Notion)
# =============================================================================
# ClickUp
CLICKUP_API_KEY=

# Jira
# JIRA_API_TOKEN=
# JIRA_BASE_URL=
# JIRA_USER_EMAIL=

# Notion
# NOTION_API_KEY=

# =============================================================================
# =============================================================================
# MONOREPO DEVELOPMENT (only for NextSpark contributors)
# =============================================================================
# =============================================================================

# =============================================================================
# NPM TOKENS (for publishing packages)
# =============================================================================
NPM_NEXTSPARK_TOKEN=
NPM_CREATE_NEXTSPARK_APP_TOKEN=

# =============================================================================
# WEBHOOKS (for development/testing)
# =============================================================================
WEBHOOK_URL_TASKS=
WEBHOOK_URL_SUBSCRIPTIONS=

# =============================================================================
