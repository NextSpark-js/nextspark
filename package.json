{
  "name": "nextspark-monorepo",
  "private": true,
  "version": "0.1.0-beta.54",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm build:cli && pnpm --filter @nextsparkjs/dev dev",
    "build": "pnpm build:cli && pnpm --filter @nextsparkjs/dev build",
    "build:core": "pnpm --filter @nextsparkjs/core... build",
    "build:registries": "cd apps/dev && node ../../packages/cli/dist/cli.js prepare",
    "build:cli": "pnpm --filter @nextsparkjs/cli build",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf node_modules dist .next",
    "setup:local": "./scripts/setup/local.sh",
    "setup:npm": "./scripts/setup/npm.sh",
    "setup:update-local": "./scripts/setup/update-local.sh",
    "setup:mobile-local": "./scripts/setup/mobile-local.sh",
    "setup:claude": "./scripts/setup/claude.sh",
    "pkg:validate": "npx tsx scripts/packages/validate-versions.ts",
    "pkg:version": "./scripts/packages/version.sh",
    "pkg:pack": "./scripts/packages/pack.sh --all --clean",
    "pkg:verify-tarballs": "node scripts/packages/verify-tarballs.mjs --expect-all",
    "pkg:publish": "./scripts/packages/publish.sh ./.packages",
    "sync:mobile-templates": "npx tsx scripts/packages/sync-mobile-templates.ts",
    "sync:mobile-templates:check": "npx tsx scripts/packages/sync-mobile-templates.ts --check",
    "sync:mobile-templates:sync": "npx tsx scripts/packages/sync-mobile-templates.ts --sync",
    "cy:open": "cd apps/dev && node ../../packages/core/scripts/test/cy.mjs open",
    "cy:run": "cd apps/dev && node ../../packages/core/scripts/test/cy.mjs run",
    "cy:tags": "cd apps/dev && node ../../packages/core/scripts/test/cy.mjs tags",
    "test:core": "pnpm --filter @nextsparkjs/core test",
    "test:audit-log-rls": "pnpm exec tsx packages/core/tests/e2e/audit-log-rls.test.ts",
    "db:drop": "cd apps/dev && node scripts/drop-all-tables.mjs",
    "db:migrate": "cd apps/dev && node ../../packages/core/scripts/db/run-migrations.mjs",
    "db:reset": "cd apps/dev && node scripts/drop-all-tables.mjs && node ../../packages/core/scripts/db/run-migrations.mjs --sample-data",
    "db:seed": "cd apps/dev && node ../../packages/core/scripts/db/run-migrations.mjs --sample-data",
    "db:verify-theme": "node packages/core/scripts/db/verify-theme-migrations.mjs",
    "mobile:install": "cd apps/mobile && pnpm install",
    "mobile:start": "cd apps/mobile && pnpm start",
    "mobile:web": "cd apps/mobile && pnpm run web",
    "mobile:verify": "node scripts/packages/mobile-verify.mjs",
    "mobile:boundary": "node scripts/packages/mobile-boundary.mjs",
    "contracts:generate": "cd apps/dev && node ../../packages/core/scripts/build/registry/host/prepare-cli.mjs --contracts-only",
    "contracts:check": "cd apps/dev && node ../../packages/core/scripts/build/registry/host/prepare-cli.mjs --contracts-only --check",
    "test:route-js-budget": "node --test scripts/performance/verify-route-js-budget.test.mjs",
    "verify:route-js-budget": "node scripts/performance/verify-route-js-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cypress/grep": "^5.0.1",
    "@testing-library/cypress": "^10.1.0",
    "allure-cypress": "^3.0.0",
    "axe-core": "4.14.0",
    "cypress": "^15.8.2",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "jiti": "^2.6.1",
    "playwright": "1.63.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "next": "~16.4.2",
    "pg": "^8.16.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "pnpm": {
    "overrides": {
      "next": "16.4.2",
      "next-intl": "4.11.0",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "react-test-renderer": "19.2.4",
      "@types/node": "20.19.27",
      "zod@^4": "4.6.5",
      "sharp": "^0.35.5",
      "handlebars": "^4.7.10",
      "@cypress/request>qs": "^6.16.0",
      "react-devtools-core>shell-quote": "^1.9.0",
      "react-devtools-core>ws": "^7.5.11",
      "react-native>ws": "^7.5.11",
      "@react-native/dev-middleware>ws": "^7.5.11",
      "metro>ws": "^7.5.11",
      "@expo/plist>@xmldom/xmldom": "^0.8.15",
      "plist>@xmldom/xmldom": "^0.8.15",
      "@expo/cli>compression": "^1.8.2",
      "@expo/xcpretty>js-yaml": "^4.3.2",
      "@babel/preset-env>@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "picomatch@^4": "^4.0.4",
      "minimatch@^9": "^9.0.7",
      "brace-expansion@^2": "^2.1.6"
    }
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=9.0.0"
  }
}
