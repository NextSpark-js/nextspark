# Marketplace payments: copy to plugins/marketplace-payments/.env or set these in the project's environment.

# --- Commission ------------------------------------------------------------
# Required to create a checkout. Basis points: 1000 is 10%.
MARKETPLACE_COMMISSION_BPS=1000
# Optional, in minor units (cents).
# MARKETPLACE_COMMISSION_FIXED_CENTS=30
# MARKETPLACE_COMMISSION_MIN_CENTS=50
# MARKETPLACE_COMMISSION_MAX_CENTS=5000

# --- Stripe Connect --------------------------------------------------------
MARKETPLACE_STRIPE_SECRET_KEY=sk_test_xxx
# Comma-separated: the platform endpoint's secret, the connected-accounts endpoint's, and any being rotated.
MARKETPLACE_STRIPE_WEBHOOK_SECRETS=whsec_platform,whsec_connect

# --- MercadoPago -----------------------------------------------------------
MARKETPLACE_MERCADOPAGO_CLIENT_ID=
MARKETPLACE_MERCADOPAGO_CLIENT_SECRET=
# Comma-separated: the signature secret of the application's webhooks, and any being rotated.
MARKETPLACE_MERCADOPAGO_WEBHOOK_SECRETS=
# true: send buyers to sandbox_init_point.
# MARKETPLACE_MERCADOPAGO_SANDBOX=true

# Encrypts sellers' MercadoPago tokens. <id>:<base64 of 32 bytes>, the first one encrypts.
# Generate a key: openssl rand -base64 32
MARKETPLACE_TOKEN_KEYS=k1:replace-with-base64-of-32-bytes
