{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["../../*"],
      "@/plugins/*": ["../*"],
      "~/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "plugin.config.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
