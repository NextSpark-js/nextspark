{
  "production": {
    "keys": [
      "basePath",
      "cacheComponents",
      "partialPrefetching",
      "agentRules",
      "transpilePackages",
      "serverExternalPackages",
      "turbopack",
      "experimental",
      "outputFileTracingIncludes",
      "modularizeImports",
      "images",
      "webpack",
      "redirects",
      "headers"
    ],
    "headers": [
      {
        "source": "/:path*",
        "headers": [
          {
            "key": "Reporting-Endpoints",
            "value": "csp-endpoint=\"/api/csp-report\""
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://lh3.googleusercontent.com https://*.public.blob.vercel-storage.com https://images.unsplash.com https://upload.wikimedia.org https://i.pravatar.cc https://*.supabase.co https://*.cloudinary.com; font-src 'self' data:; connect-src 'self' https://api.stripe.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; report-uri /api/csp-report; report-to csp-endpoint"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/superadmin",
        "destination": "/login?callbackUrl=/superadmin",
        "permanent": false,
        "missing": [
          {
            "type": "cookie",
            "key": "__Secure-better-auth.session_token"
          },
          {
            "type": "cookie",
            "key": "better-auth.session_token"
          }
        ]
      },
      {
        "source": "/superadmin/:path*",
        "destination": "/login?callbackUrl=/superadmin/:path*",
        "permanent": false,
        "missing": [
          {
            "type": "cookie",
            "key": "__Secure-better-auth.session_token"
          },
          {
            "type": "cookie",
            "key": "better-auth.session_token"
          }
        ]
      },
      {
        "source": "/devtools",
        "destination": "/login?callbackUrl=/devtools",
        "permanent": false,
        "missing": [
          {
            "type": "cookie",
            "key": "__Secure-better-auth.session_token"
          },
          {
            "type": "cookie",
            "key": "better-auth.session_token"
          }
        ]
      },
      {
        "source": "/devtools/:path*",
        "destination": "/login?callbackUrl=/devtools/:path*",
        "permanent": false,
        "missing": [
          {
            "type": "cookie",
            "key": "__Secure-better-auth.session_token"
          },
          {
            "type": "cookie",
            "key": "better-auth.session_token"
          }
        ]
      }
    ]
  },
