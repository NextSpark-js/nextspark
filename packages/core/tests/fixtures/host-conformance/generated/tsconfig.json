{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../source/*"
      ],
      "@fixture-core/*": [
        "../fake-core/*"
      ],
      "@nextsparkjs/registries/*": [
        "./.nextspark/registries/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".nextspark/registries/**/*.ts",
    "../source/**/*.ts",
    "../source/**/*.tsx",
    "../fake-core/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
